#include <iostream>
using namespace std;

class Add {
public:
    
    void add(int a, int b) {
        cout << "Integer sum = " << a + b << endl;
    }

    void add(double a, double b) {
        cout << "Float sum = " << a + b << endl;
    }
};

int main() {
    Add obj;

    obj.add(25, 43);       
    obj.add(43.5, 25.9);    

    return 0;

}
