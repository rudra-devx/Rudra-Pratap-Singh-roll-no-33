#include <iostream>
using namespace std;

class Complex {
public:
    int real, imag;

  
    Complex(int r, int i) {
        real = r;
        imag = i;
    }
    Complex operator + (Complex obj) {
        Complex temp(0, 0);
        temp.real = real + obj.real;
        temp.imag = imag + obj.imag;
        return temp;
    }
    void display() {
        cout << real << " + i" << imag << endl;
    }
};

int main() {
    Complex c1(10, 5), c2(2, 4);

    Complex c3 = c1 + c2;  

    c3.display();

    return 0;
}
